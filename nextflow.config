// Nextflow config — BUB1B N1002K unified pipeline (structure + MD)
// Host has no Docker/Singularity -> local executor + micromamba envs.

params {
    outdir      = 'results'
    acc         = 'O60566'      // UniProt O60566 = BUB1B_HUMAN (1050 aa)
    kstart      = 750           // pseudokinase-region start (GRCh38 construct)
    kend        = 1050          // ... end
    mut_resid   = 1002          // p.Asn1002Lys
    mut_aa      = 'LYS'

    env_struct  = 'bubdock'     // fpocket / pymol / biopython
    env_md      = 'bubmd'       // openmm / pdbfixer / mdtraj

    run_md      = true          // set false to run Stage 1 only
    md_ns       = 10            // production length per state
    md_equil_ns = 0.5
    md_threads  = 32            // sweet spot on this 64-core node
    save_ps     = 100           // trajectory frame spacing
}

executor {
    name   = 'local'
    cpus   = 64
    memory = '16 GB'
}

workDir = 'work'

conda { enabled = false }

process {
    errorStrategy = 'retry'
    maxRetries    = 1
}

// Quick smoke profile: tiny MD so the whole DAG runs in minutes.
profiles {
    test {
        params.run_md      = true
        params.md_ns       = 0.01
        params.md_equil_ns = 0.02
        params.md_threads  = 4
        params.save_ps     = 5
    }
    structure_only {
        params.run_md = false
    }
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.tsv"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_report.html"
}
